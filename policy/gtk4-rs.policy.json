{
  "$id": "policy/gtk4_rs.v1.json",
  "title": "gtk4-rs Policy (gtk4 0.11.3)",
  "package_id": "gnome_rust_app_policy_pack.v1",
  "machine_readable_for": [
    "llm_agent",
    "codex",
    "claude"
  ],
  "purpose": "Strict policy for GTK 4 Rust bindings in a native GNOME application.",
  "applies_to": [
    "src/**",
    "crates/**",
    "tests/**",
    "data/ui/**",
    "data/resources.gresource.xml",
    "**/*.rs",
    "**/*.ui",
    "**/*.blp",
    "**/*.gresource.xml"
  ],
  "overlaps_with": [
    "policy/rust.v4.json",
    "policy/libadwaita.v2.json",
    "policy/hig.v2.json",
    "policy/flatpak_metadata.v1.json"
  ],
  "conflict_resolution": "union_strictest",
  "severity": "error",
  "targets": {
    "crate": {
      "cargo_package": "gtk4",
      "target_version": "0.11.3",
      "preferred_crate_alias": "gtk"
    },
    "gtk": {
      "major_version": "4"
    }
  },
  "application_model": {
    "manual_gtk_init_or_main_loop_management": "forbidden",
    "application_object_required": true,
    "prefer_adw_application_when_libadwaita_is_present": true,
    "single_application_id_required": true,
    "gio_actions_required_for_user_commands": true,
    "accelerators_must_be_registered_via_action_system": true
  },
  "ui_construction": {
    "composite_template_preferred_for_custom_widgets": true,
    "builder_xml_or_blueprint_must_be_resource_backed": true,
    "stable_object_ids_required_for_lookups": true,
    "inline_builder_xml_strings": "forbidden_by_default",
    "imperative_widget_tree_construction_for_large_views": "forbidden_by_default",
    "all_top_level_windows_must_be_constructed_from_application_lifecycle": true
  },
  "main_loop_and_concurrency": {
    "blocking_operations_on_main_loop": "forbidden",
    "background_work_requires_gio_spawn_blocking_or_async_api": true,
    "ui_updates_from_background_threads": "forbidden",
    "long_running_operations_must_surface_progress_or_busy_state": true
  },
  "signals_and_lifetimes": {
    "glib_clone_macro_preferred_for_signal_closures": true,
    "weak_references_required_for_widget_back_references_by_default": true,
    "strong_widget_capture_requires_cycle_review": true,
    "signal_connections_must_not_hide_panic_paths": true
  },
  "resources": {
    "ui_css_icons_shortcuts_help_and_about_assets_should_be_in_gresource": true,
    "resource_prefix_should_be_application_id_based": true,
    "runtime_file_system_lookups_for_packaged_ui_assets": "forbidden"
  },
  "platform_integrations": {
    "file_open_save_should_use_portal_friendly_native_apis": true,
    "external_uri_opening_should_use_uri_launcher_or_equivalent": true,
    "clipboard_drag_drop_print_and_notifications_should_use_toolkit_or_gio_apis": true
  },
  "styling": {
    "custom_css_is_supplemental_only": true,
    "global_reset_css": "forbidden",
    "widget_name_or_internal_css_node_targeting": "forbidden_by_default",
    "app_must_remain_usable_without_custom_css": true
  },
  "testing": {
    "widget_tests_should_use_gtk_test_harness": true,
    "gtk_test_attribute_preferred": true,
    "tests_must_not_depend_on_working_directory_layout": true
  },
  "verifiers": {
    "grep_checks": [
      "\\bgtk::init\\s*\\(",
      "\\bgtk::main\\s*\\(",
      "\\bBuilder::from_string\\s*\\(",
      "\\bstd::thread::sleep\\s*\\(",
      "\\bconnect_\\w+\\s*\\(\\s*move\\s*\\|",
      "\\bset_widget_name\\s*\\("
    ],
    "grep_warnings": [
      "\\bObjectExt::set_data\\b",
      "\\bglib::MainContext::spawn_local\\b",
      "\\bglib::idle_add\\b",
      "\\bclone!\\s*\\(",
      "\\bCompositeTemplate\\b"
    ]
  },
  "prohibited": [
    "manual_gtk_init_in_application_code",
    "manual_gtk_main_loop_control",
    "blocking_main_loop_work",
    "inline_large_builder_markup",
    "runtime_lookup_of_packaged_ui_files_outside_resources",
    "strong_reference_cycles_in_signal_handlers",
    "stylesheet_strategies_that_fight_gtk_or_libadwaita"
  ],
  "official_sources": [
    {
      "name": "gtk4 crate 0.11.3",
      "url": "https://crates.io/crates/gtk4/0.11.3",
      "kind": "crate_release"
    },
    {
      "name": "gtk-rs GTK 4 book",
      "url": "https://gtk-rs.org/gtk4-rs/stable/latest/book/",
      "kind": "official_book"
    },
    {
      "name": "gtk-rs core docs",
      "url": "https://gtk-rs.org/gtk-rs-core/stable/latest/docs/",
      "kind": "api_docs"
    },
    {
      "name": "Flatpak manifests",
      "url": "https://docs.flatpak.org/en/latest/manifests.html",
      "kind": "spec"
    },
    {
      "name": "Flatpak sandbox permissions",
      "url": "https://docs.flatpak.org/en/latest/sandbox-permissions.html",
      "kind": "spec"
    },
    {
      "name": "Flatpak desktop integration",
      "url": "https://docs.flatpak.org/en/latest/desktop-integration.html",
      "kind": "spec"
    },
    {
      "name": "Flathub org.gnome.Platform 50",
      "url": "https://flathub.org/apps/org.gnome.Platform",
      "kind": "runtime_listing"
    }
  ]
}
