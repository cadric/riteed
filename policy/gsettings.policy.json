{
  "$id": "policy/gsettings.v2.json",
  "title": "GSettings Policy",
  "package_id": "gnome_rust_app_policy_pack.v1",
  "machine_readable_for": [
    "llm_agent",
    "codex",
    "claude"
  ],
  "purpose": "Strict persistence policy for app preferences and lightweight durable state using GSettings.",
  "applies_to": [
    "src/**",
    "data/schemas/**",
    "build-aux/**",
    "**/*.rs",
    "**/*.gschema.xml"
  ],
  "overlaps_with": [
    "policy/rust.v4.json",
    "policy/gettext_i18n.v2.json",
    "policy/flatpak_metadata.v1.json"
  ],
  "conflict_resolution": "union_strictest",
  "severity": "error",
  "targets": {
    "gio_settings": {
      "api": "Gio.Settings",
      "schema_tool": "glib-compile-schemas"
    }
  },
  "scope_of_use": {
    "required_for_durable_user_preferences": true,
    "required_for_window_state_and_lightweight_ui_state": true,
    "forbidden_for_secrets": true,
    "forbidden_for_large_blobs": true,
    "forbidden_for_logs_caches_or_document_content": true,
    "ad_hoc_json_toml_yaml_config_for_preferences": "forbidden"
  },
  "schema_rules": {
    "schema_files_must_use_gschema_xml_extension": true,
    "schema_id_must_be_reverse_dns": true,
    "schema_id_must_align_with_application_id": true,
    "schema_path_required_for_non_relocatable_app_prefs": true,
    "every_key_requires_type_default_summary_description": true,
    "summary_and_description_must_be_localizable": true,
    "enum_or_range_types_preferred_over_free_form_strings": true,
    "relocatable_schemas_for_main_app_preferences": "forbidden_by_default"
  },
  "write_policy": {
    "writes_only_in_response_to_explicit_user_action": true,
    "writes_during_startup": "forbidden",
    "write_on_every_keystroke": "forbidden",
    "startup_widget_binding_must_not_cause_spurious_writes": true,
    "multi_setting_preference_edits_should_use_delay_apply_or_equivalent_reviewed_flow": true
  },
  "runtime_rules": {
    "settings_bindings_preferred_for_simple_widget_bindings": true,
    "manual_deserialize_json_inside_string_keys": "forbidden",
    "schema_compilation_at_runtime": "forbidden",
    "schema_install_location_must_be_standard": true
  },
  "enforcement": {
    "write_pattern": "\\.set_(string|boolean|int|uint|double|strv|enum|flags)\\s*\\(|\\.set_value\\s*\\(",
    "bind_pattern": "\\.bind\\s*\\(",
    "startup_contexts": [
      "startup",
      "activate",
      "constructed",
      "setup",
      "init"
    ],
    "per_keystroke_signals": [
      "connect_changed",
      "connect_search_changed",
      "connect_insert_text",
      "connect_delete_text",
      "notify::text"
    ]
  },
  "validation": {
    "glib_compile_schemas_strict_dry_run_required": true,
    "compiled_schema_artifact_must_not_be_committed": true
  },
  "verifiers": {
    "grep_checks": [
      "\\bSettings::new\\b",
      "\\bset_\\w+\\b",
      "\\bget_\\w+\\b",
      "\\.gschema\\.xml\\b"
    ],
    "grep_warnings": [
      "\\bserde_json\\b",
      "\\bstd::fs\\b",
      "\\bdirs::config_dir\\b"
    ],
    "command_checks": [
      "glib-compile-schemas --strict --dry-run data/schemas"
    ]
  },
  "prohibited": [
    "preferences_stored_in_custom_config_files",
    "schema_ids_not_aligned_with_application_id",
    "runtime_schema_compilation",
    "startup_writes_to_gsettings",
    "json_or_other_structured_blob_packing_inside_string_keys"
  ],
  "official_sources": [
    {
      "name": "Gio.Settings docs",
      "url": "https://docs.gtk.org/gio/class.Settings.html",
      "kind": "api_docs"
    },
    {
      "name": "glib-compile-schemas",
      "url": "https://gnome.pages.gitlab.gnome.org/libsoup/gio/glib-compile-schemas.html",
      "kind": "tool_docs"
    },
    {
      "name": "GNOME application ID guidance",
      "url": "https://developer.gnome.org/documentation/tutorials/application-id.html",
      "kind": "developer_guidance"
    },
    {
      "name": "GNU gettext manual - Rust",
      "url": "https://www.gnu.org/software/gettext/manual/html_node/Rust.html",
      "kind": "manual"
    },
    {
      "name": "gettext-rs 0.7.7",
      "url": "https://docs.rs/crate/gettext-rs/0.7.7/source/README.md",
      "kind": "crate_docs"
    },
    {
      "name": "GNOME localization guidance",
      "url": "https://developer.gnome.org/documentation/guidelines/localization.html",
      "kind": "developer_guidance"
    }
  ]
}
