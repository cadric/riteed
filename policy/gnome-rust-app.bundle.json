{
  "$id": "policy/gnome_rust_app.bundle.v3.json",
  "title": "GNOME Rust Application Policy Bundle (Rust 1.95 / GNOME 50)",
  "package_id": "gnome_rust_app_policy_pack.v1",
  "package_version": "1.2.0",
  "machine_readable_for": [
    "llm_agent",
    "codex",
    "claude"
  ],
  "purpose": "Policy bundle for generating and reviewing a strict native GNOME desktop application written in Rust. Intended for automated code generation, review, and remediation agents.",
  "applies_to": [
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    ".cargo/config.toml",
    "src/**",
    "crates/**",
    "tests/**",
    "data/**",
    "po/**",
    "build-aux/**",
    "resources/**",
    "**/*.rs",
    "**/*.ui",
    "**/*.blp",
    "**/*.css",
    "**/*.gresource.xml",
    "**/*.desktop.in",
    "**/*.metainfo.xml.in",
    "**/*.gschema.xml",
    "**/*.yml",
    "**/*.yaml",
    "**/*.json"
  ],
  "overlaps_with": [
    "policy/rust.v4.json",
    "policy/gtk4_rs.v1.json",
    "policy/libadwaita.v2.json",
    "policy/hig.v2.json",
    "policy/gettext_i18n.v2.json",
    "policy/gsettings.v2.json",
    "policy/flatpak_metadata.v1.json",
    "policy/release.v1.json",
    "policy/stress_fuzz.v1.json",
    "policy/validation_tooling.v2.json"
  ],
  "conflict_resolution": "union_strictest",
  "severity": "error",
  "agent_contract": {
    "intended_consumers": [
      "llm_agent",
      "codex",
      "claude"
    ],
    "merge_strategy": "union_strictest",
    "deny_over_allow": true,
    "more_specific_scope_wins": true,
    "missing_context_behavior": "assume_stricter_interpretation",
    "unknown_api_behavior": "prefer_official_gnome_stack_and_do_not_introduce_new_frameworks",
    "when_constraints_conflict": "prefer_native_gnome_behavior_over_generic_rust_convenience",
    "load_order": [
      "rust.policy.json",
      "gtk4-rs.policy.json",
      "libadwaita.policy.json",
      "hig.policy.json",
      "gettext-i18n.policy.json",
      "gsettings.policy.json",
      "flatpak-metadata.policy.json",
      "release.policy.json",
      "stress-fuzz.policy.json",
      "validation-tooling.policy.json"
    ],
    "generation_requirements": {
      "must_preserve_application_id_consistency": true,
      "must_keep_all_user_visible_strings_localizable": true,
      "must_not_weaken_sandbox_or_unsafe_rules": true,
      "must_prefer_portals_over_broad_permissions": true,
      "must_prefer_official_gtk_and_libadwaita_patterns": true,
      "if_requirement_cannot_be_met": "emit_smallest_possible_change_and_explicit_remediation_note"
    }
  },
  "targets": {
    "rust": {
      "toolchain_family": "1.95.x",
      "edition": "2024",
      "stable_only": true
    },
    "gnome": {
      "platform_release": "50",
      "runtime": "org.gnome.Platform",
      "sdk": "org.gnome.Sdk"
    },
    "gtk4_rs": {
      "crate": "gtk4",
      "target_version": "0.11.3"
    },
    "libadwaita_rs": {
      "crate": "libadwaita",
      "target_version": "0.9.1"
    },
    "libadwaita": {
      "library_family": "1.9.x"
    },
    "gettext": {
      "rust_binding_target": "gettext-rs 0.7.7",
      "gnu_gettext_minimum_version": "0.26"
    },
    "flatpak": {
      "runtime_version": "50",
      "flatpak_stable_family": "1.16.x",
      "flatpak_builder_stable_family": "1.4.x"
    }
  },
  "required_repository_layout": {
    "must_exist": [
      "Cargo.toml",
      "Cargo.lock",
      "rust-toolchain.toml",
      "src/main.rs",
      "data/",
      "po/",
      "build-aux/"
    ],
    "contract_must_exist": [
      "AGENTS.md",
      "policy/",
      "tools/"
    ],
    "preferred_paths": {
      "gtk_ui": "data/ui/",
      "icons": "data/icons/",
      "css": "data/ui/ or data/style/",
      "gsettings_schemas": "data/schemas/",
      "desktop_file": "data/{application_id}.desktop.in",
      "metainfo_file": "data/{application_id}.metainfo.xml.in",
      "flatpak_manifest": "build-aux/{application_id}.yml",
      "gettext_catalogs": "po/*.po",
      "gresource_manifest": "data/resources.gresource.xml"
    },
    "repository_kind": "target_application_repository_or_embedded_app_subtree",
    "validated_from": "repository_root_passed_to_policy_check",
    "embedded_contract_resolution": "embedded app subtrees may inherit AGENTS.md, policy/, and tools/ from the nearest ancestor contract root"
  },
  "cross_file_invariants": {
    "application_id": {
      "format": "reverse_dns",
      "must_match": [
        "GApplication application-id",
        "Flatpak manifest id",
        "desktop file basename",
        "metainfo component id",
        "GSettings schema basename or prefix",
        "gettext package/domain",
        "resource path prefix",
        "icon basename",
        "D-Bus name when present"
      ]
    },
    "translation_domain": {
      "required": true,
      "must_equal_application_id": true
    },
    "resource_policy": {
      "ui_css_icons_shortcuts_metainfo_preferred_in_gresource": true,
      "runtime_file_lookups_outside_standard_prefixes": "forbidden_by_default"
    },
    "platform_policy": {
      "native_gnome_stack_only": true,
      "portals_preferred_over_permissions": true,
      "libadwaita_and_hig_compliance_required": true,
      "flatpak_sandbox_first": true,
      "durable_preferences_and_lightweight_ui_state_must_use_gsettings": true
    }
  },
  "bundle_contains": [
    {
      "file": "rust.policy.json",
      "$id": "policy/rust.v4.json",
      "role": "language_and_project_core"
    },
    {
      "file": "gtk4-rs.policy.json",
      "$id": "policy/gtk4_rs.v1.json",
      "role": "gtk_binding_usage"
    },
    {
      "file": "libadwaita.policy.json",
      "$id": "policy/libadwaita.v2.json",
      "role": "adaptive_gnome_widgets_and_style"
    },
    {
      "file": "hig.policy.json",
      "$id": "policy/hig.v2.json",
      "role": "design_and_interaction_rules"
    },
    {
      "file": "gettext-i18n.policy.json",
      "$id": "policy/gettext_i18n.v2.json",
      "role": "localization_and_source_string_rules"
    },
    {
      "file": "gsettings.policy.json",
      "$id": "policy/gsettings.v2.json",
      "role": "persistent_preferences_and_schema_rules"
    },
    {
      "file": "flatpak-metadata.policy.json",
      "$id": "policy/flatpak_metadata.v1.json",
      "role": "sandbox_and_packaging_metadata"
    },
    {
      "file": "release.policy.json",
      "$id": "policy/release.v1.json",
      "role": "signed_flatpak_release_and_supply_chain_governance"
    },
    {
      "file": "stress-fuzz.policy.json",
      "$id": "policy/stress_fuzz.v1.json",
      "role": "trust_boundary_fuzz_and_stress_evidence"
    },
    {
      "file": "validation-tooling.policy.json",
      "$id": "policy/validation_tooling.v2.json",
      "role": "hard_fail_enforcement_and_ci_validation"
    }
  ],
