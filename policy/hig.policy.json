{
  "$id": "policy/hig.v2.json",
  "title": "GNOME Human Interface Guidelines Policy",
  "package_id": "gnome_rust_app_policy_pack.v1",
  "machine_readable_for": [
    "llm_agent",
    "codex",
    "claude"
  ],
  "purpose": "Machine-readable design, interaction, accessibility, and writing constraints derived from the GNOME HIG for GTK 4 and libadwaita applications.",
  "applies_to": [
    "src/**",
    "data/ui/**",
    "data/style/**",
    "data/*.desktop.in",
    "data/*.metainfo.xml.in",
    "**/*.rs",
    "**/*.ui",
    "**/*.blp",
    "**/*.css",
    "**/*.desktop.in",
    "**/*.metainfo.xml.in"
  ],
  "overlaps_with": [
    "policy/gtk4_rs.v1.json",
    "policy/libadwaita.v2.json",
    "policy/gettext_i18n.v2.json",
    "policy/flatpak_metadata.v1.json"
  ],
  "conflict_resolution": "union_strictest",
  "severity": "error",
  "targets": {
    "hig": {
      "target": "current",
      "platform_context": "GTK 4 + Libadwaita",
      "gnome_release_context": "50"
    }
  },
  "naming_and_identity": {
    "app_name_should_be_short": true,
    "app_name_should_prefer_one_or_two_simple_nouns": true,
    "marketing_style_punctuation_in_app_name": "forbidden",
    "desktop_name_and_metainfo_name_must_match": true
  },
  "layout_and_adaptiveness": {
    "must_work_in_constrained_window_sizes": true,
    "smallest_supported_window_size_must_be_designed_intentionally": true,
    "horizontal_space_assumptions": "forbidden",
    "sidebar_or_split_layouts_must_collapse_gracefully": true
  },
  "writing": {
    "source_language_must_be_us_english": true,
    "must_use_clear_simple_consistent_terms": true,
    "must_use_standard_gnome_ui_terms": true,
    "sentence_concatenation_across_multiple_controls": "forbidden",
    "latin_abbreviations_like_eg_ie": "forbidden",
    "header_capitalization_required_for_titles_and_short_control_labels": true
  },
  "accessibility": {
    "all_interactive_elements_must_have_descriptive_accessible_names": true,
    "accessible_names_must_be_short_and_specific": true,
    "color_alone_must_not_convey_state_or_required_action": true,
    "keyboard_navigation_required": true,
    "focus_order_must_follow_visual_and_task_order": true
  },
  "standard_actions_and_shortcuts": {
    "quit_ctrl_q_required_when_app_can_quit": true,
    "close_ctrl_w_required_when_window_or_tab_can_close": true,
    "help_f1_required_when_help_exists": true,
    "shortcuts_ctrl_question_required_when_shortcuts_dialog_exists": true,
    "preferences_ctrl_comma_required_when_preferences_exist": true
  },
  "feedback_patterns": {
    "toast_for_transient_in_window_feedback": true,
    "toast_for_undo_after_destructive_action_preferred": true,
    "notifications_only_for_events_relevant_outside_active_window": true,
    "dialogs_only_for_interruption_or_confirmation_that_cannot_be_undone": true,
    "ongoing_state_should_use_banners_or_inline_status_not_toasts": true
  },
  "menus_and_commands": {
    "primary_menu_must_remain_small_and_high_value": true,
    "duplicate_commands_in_multiple_surfaces": "forbidden_by_default",
    "about_preferences_keyboard_shortcuts_and_help_should_use_standard_locations": true,
    "primary_menu_quit_and_close_forbidden": true
  },
  "enforcement": {
    "primary_menu_max_items": 12,
    "required_primary_menu_items": [
      "about"
    ],
    "hard_fail_patterns": [
      {
        "message": "User-facing copy must not use Latin abbreviations such as e.g. or i.e.",
        "pattern": "\\b(e\\.g\\.|i\\.e\\.)\\b",
        "paths": [
          "src/**/*.rs",
          "data/**/*.ui",
          "data/**/*.blp",
          "data/**/*.desktop.in",
          "data/**/*.metainfo.xml.in",
          "data/**/*.gschema.xml"
        ]
      }
    ],
    "forbidden_primary_menu_items": [
      "quit",
      "close"
    ]
  },
  "destructive_actions": {
    "must_be_clearly_labeled": true,
    "must_not_use_ambiguous_ok_cancel_copy": true,
    "confirmation_required_when_irreversible_and_no_undo": true
  },
  "prohibited": [
    "desktop_ui_that_ignores_adaptiveness",
    "unclear_or_technical_user_facing_copy",
    "sentence_fragments_split_across_controls",
    "notifications_for_in_window_only_feedback",
    "reliance_on_color_only_for_meaning",
    "nonstandard_shortcuts_for_standard_actions_without_reason"
  ],
  "official_sources": [
    {
      "name": "GNOME HIG",
      "url": "https://developer.gnome.org/hig/",
      "kind": "design_spec"
    }
  ]
}
