{
  "$id": "policy/libadwaita.v2.json",
  "title": "libadwaita Policy (libadwaita-rs 0.9.1 / libadwaita 1.9.x)",
  "package_id": "gnome_rust_app_policy_pack.v1",
  "machine_readable_for": [
    "llm_agent",
    "codex",
    "claude"
  ],
  "purpose": "Strict policy for native GNOME adaptive UI with libadwaita.",
  "applies_to": [
    "src/**",
    "crates/**",
    "data/ui/**",
    "data/style/**",
    "**/*.rs",
    "**/*.ui",
    "**/*.blp",
    "**/*.css"
  ],
  "overlaps_with": [
    "policy/rust.v4.json",
    "policy/gtk4_rs.v1.json",
    "policy/hig.v2.json",
    "policy/flatpak_metadata.v1.json"
  ],
  "conflict_resolution": "union_strictest",
  "severity": "error",
  "targets": {
    "crate": {
      "cargo_package": "libadwaita",
      "target_version": "0.9.1",
      "preferred_crate_alias": "adw"
    },
    "library": {
      "target_family": "1.9.x"
    },
    "gnome": {
      "platform_release": "50"
    }
  },
  "application_shell": {
    "adw_application_required": true,
    "adw_application_window_required_for_primary_windows": true,
    "startup_handler_must_chain_up_before_using_adwaita_api": true
  },
  "adaptive_layout": {
    "adaptive_behavior_required": true,
    "design_for_small_windows_first": true,
    "prefer_navigationview_for_drill_down_navigation": true,
    "prefer_navigationsplitview_for_two_pane_adaptive_layouts": true,
    "prefer_toolbarview_for_modern_header_and_content_structure": true,
    "statuspage_preferred_for_empty_loading_or_error_states": true
  },
  "preferences_and_feedback": {
    "preferencesdialog_or_preferenceswindow_required_for_app_preferences": true,
    "toastoverlay_required_for_transient_in_window_feedback": true,
    "aboutdialog_required_for_about_surface": true,
    "aboutdialog_should_use_appdata_resource_path_when_metainfo_is_resource_backed": true
  },
  "style_and_theming": {
    "adw_style_manager_required_for_color_scheme_integration": true,
    "respect_system_light_dark_and_accent_preferences": true,
    "forcing_custom_theme_or_color_scheme": "forbidden_except_explicit_user_selected_light_dark_app_preference",
    "replacing_core_adwaita_spacing_typography_or_widget_shapes": "forbidden",
    "custom_css_only_for_app_specific_additions": true
  },
  "patterns": {
    "leaflet_stack_sidebar_patterns_from_gtk3_era": "forbidden_by_default",
    "headerbar_content_split_should_follow_toolbarview_or_navigation_patterns": true,
    "non_adaptive_fixed_size_dialogs": "forbidden_by_default"
  },
  "documentation_requirements": {
    "public_ui_components_must_document_adaptive_behavior": true,
    "custom_css_must_include_reason_and_scope": true
  },
  "enforcement": {
    "hard_fail_patterns": [
      {
        "message": "Libadwaita apps must not force a custom color scheme.",
        "pattern": "ColorScheme::Force(Light|Dark)",
        "paths": ["src/**/*.rs", "crates/**/*.rs"],
        "exceptions": ["src/settings/appearance.rs"]
      },
      {
        "message": "GTK3-era Leaflet patterns are forbidden by default.",
        "pattern": "\\b(Leaflet|HdyLeaflet|StackSidebar)\\b",
        "paths": [
          "src/**/*.rs",
          "crates/**/*.rs",
          "data/**/*.ui",
          "data/**/*.blp"
        ]
      },
      {
        "message": "Core Adwaita typography, sizing, and widget-shape overrides are forbidden.",
        "pattern": "^\\s*(window|button|entry|label|headerbar)\\s*\\{",
        "paths": [
          "data/style/**/*.css"
        ]
      }
    ]
  },
  "verifiers": {
    "grep_checks": [
      "\\b(adw::Application|libadwaita::Application)\\b",
      "\\bAboutDialog\\b",
      "\\bToastOverlay\\b"
    ],
    "grep_warnings": [
      "\\bset_color_scheme\\b",
      "\\badd_css_class\\b",
      "\\bload_from_data\\b",
      "\\bPreferences(Window|Dialog)\\b",
      "\\bNavigation(SplitView|View)\\b",
      "\\bStatusPage\\b"
    ]
  },
  "prohibited": [
    "gtk_only_window_shell_when_libadwaita_is_available",
    "unreviewed_custom_theme_forcing",
    "nonadaptive_large_screen_only_layouts",
    "about_dialogs_not_using_libadwaita",
    "preferences_surfaces_not_following_libadwaita_patterns"
  ],
  "official_sources": [
    {
      "name": "libadwaita crate 0.9.1",
      "url": "https://crates.io/crates/libadwaita/0.9.1",
      "kind": "crate_release"
    },
    {
      "name": "libadwaita 1.9 docs",
      "url": "https://gnome.pages.gitlab.gnome.org/libadwaita/doc/1.9/",
      "kind": "api_docs"
    },
    {
      "name": "GNOME 50 release notes",
      "url": "https://release.gnome.org/50/",
      "kind": "release_notes"
    },
    {
      "name": "GNOME HIG",
      "url": "https://developer.gnome.org/hig/",
      "kind": "design_spec"
    }
  ]
}
