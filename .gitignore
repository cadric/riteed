# Cargo build artifacts
/target/
/app/target/
/debug/

# Rustfmt backups
**/*.rs.bk
**/__pycache__/
**/*.pyc
**/*.pyo

# Windows debug symbols
*.pdb

# Mutation testing output
**/mutants.out*/

# Flatpak local build/cache artifacts
/.flatpak-builder/
/app/.flatpak-builder/
/builddir/
/app/builddir/
/app/build-dir/
/_build/
/app/_build/
*.flatpak
/app/data/schemas/gschemas.compiled

# Local agent / editor state
/.claude/
/.codex/
/.cursor/
/.idea/
/.vscode/
/.agent/

# Coverage and temporary files
/coverage/
/app/coverage/
/coverage.out
/tmp/
/.tmp/
