# Cargo build artifacts
/target/
/app/target/
/debug/

# Rustfmt backups
**/*.rs.bk
**/__pycache__/
**/*.pyc
**/*.pyo

# Windows debug symbols
*.pdb

# Mutation testing output
**/mutants.out*/

# Generated stress corpus
/stress/corpus/*
!/stress/corpus/.gitkeep
!/stress/corpus/seeds/
!/stress/corpus/seeds/**
/stress/artifacts/*

# Flatpak local build/cache artifacts
/.flatpak-builder/
/app/.flatpak-builder/
/builddir/
/app/builddir/
/app/build-dir/
/_build/
/app/_build/
/site/
*.flatpak
/app/data/schemas/gschemas.compiled
/app/vendor/

# Local agent / editor state
/.claude/
/.codex/
/.cursor/
/.idea/
/.vscode/
/.agent/*
!/.agent/CONTINUITY.md
!/.agent/design-spikes/
!/.agent/design-spikes/**
/AUDIT*.md

# Coverage and temporary files
/coverage/
/app/coverage/
/coverage.out
/tmp/
/.tmp/
