<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.5"/>
  <object class="AdwPreferencesDialog" id="preferences_dialog">
    <property name="title" translatable="yes">Preferences</property>
    <property name="content-width">580</property>
    <property name="content-height">640</property>
    <property name="follows-content-size">false</property>
    <child>
      <object class="AdwPreferencesPage" id="general_preferences_page">
        <property name="title" translatable="yes">General</property>
        <property name="icon-name">preferences-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Application</property>
            <child>
              <object class="AdwComboRow" id="language_row">
                <property name="title" translatable="yes">App Language</property>
                <property name="subtitle" translatable="yes">Applied after restart</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Files</property>
            <child>
              <object class="AdwSwitchRow" id="autosave_row">
                <property name="title" translatable="yes">Autosave Saved Files</property>
                <property name="subtitle" translatable="yes">Automatically save existing writable files after edits</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="appearance_page">
        <property name="title" translatable="yes">Appearance</property>
        <property name="icon-name">color-select-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup" id="style_group">
            <property name="title" translatable="yes">Style</property>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Palette</property>
            <child>
              <object class="GtkFlowBox" id="palette_flow_box">
                <property name="selection-mode">single</property>
                <property name="activate-on-single-click">true</property>
                <property name="homogeneous">false</property>
                <property name="min-children-per-line">2</property>
                <property name="max-children-per-line">4</property>
                <property name="column-spacing">8</property>
                <property name="row-spacing">10</property>
                <property name="halign">center</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Font</property>
            <child>
              <object class="AdwActionRow" id="editor_font_row">
                <property name="activatable">true</property>
                <property name="title" translatable="yes">Editor Font</property>
                <property name="subtitle" translatable="yes">Monospace</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="editor_preferences_page">
        <property name="title" translatable="yes">Editor</property>
        <property name="icon-name">document-edit-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Editor View</property>
            <child>
              <object class="AdwSwitchRow" id="word_wrap_row">
                <property name="title" translatable="yes">Word Wrap</property>
                <property name="subtitle" translatable="yes">Wrap long lines inside the editor</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="line_numbers_row">
                <property name="title" translatable="yes">Line Numbers</property>
                <property name="subtitle" translatable="yes">Show line numbers in the editor gutter</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="highlight_current_line_row">
                <property name="title" translatable="yes">Highlight Current Line</property>
                <property name="subtitle" translatable="yes">Subtly highlight the line with the text cursor</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="minimap_row">
                <property name="title" translatable="yes">Show Minimap</property>
                <property name="subtitle" translatable="yes">Show a narrow document overview beside the editor</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Indentation</property>
            <child>
              <object class="AdwSwitchRow" id="insert_spaces_row">
                <property name="title" translatable="yes">Insert Spaces Instead of Tabs</property>
                <property name="subtitle" translatable="yes">Use spaces when the Tab key inserts indentation</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="tab_width_row">
                <property name="title" translatable="yes">Tab Width</property>
                <property name="subtitle" translatable="yes">Show each tab character as this many columns</property>
                <property name="editable">true</property>
                <property name="numeric">true</property>
                <property name="snap-to-ticks">true</property>
                <property name="climb-rate">1</property>
                <property name="digits">0</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">16</property>
                    <property name="value">4</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">4</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="indent_width_row">
                <property name="title" translatable="yes">Indent Width</property>
                <property name="subtitle" translatable="yes">Use this many columns for automatic indentation</property>
                <property name="editable">true</property>
                <property name="numeric">true</property>
                <property name="snap-to-ticks">true</property>
                <property name="climb-rate">1</property>
                <property name="digits">0</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">1</property>
                    <property name="upper">16</property>
                    <property name="value">4</property>
                    <property name="step-increment">1</property>
                    <property name="page-increment">4</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Large Files</property>
            <child>
              <object class="AdwExpanderRow" id="large_file_expander_row">
                <property name="title" translatable="yes">Large File Limits</property>
                <property name="subtitle" translatable="yes">Advanced thresholds for opening big files</property>
                <child>
                  <object class="AdwSpinRow" id="large_file_full_feature_limit_row">
                    <property name="title" translatable="yes">Full Features Below (MiB)</property>
                    <property name="subtitle" translatable="yes">Files smaller than this keep every editor feature; must stay below the editor limit</property>
                    <property name="editable">true</property>
                    <property name="numeric">true</property>
                    <property name="snap-to-ticks">true</property>
                    <property name="digits">0</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">1</property>
                        <property name="upper">24</property>
                        <property name="value">5</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="large_file_editor_limit_row">
                    <property name="title" translatable="yes">Editor Below (MiB)</property>
                    <property name="subtitle" translatable="yes">Largest size that opens directly in the editor; maximum 25</property>
                    <property name="editable">true</property>
                    <property name="numeric">true</property>
                    <property name="snap-to-ticks">true</property>
                    <property name="digits">0</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">2</property>
                        <property name="upper">25</property>
                        <property name="value">25</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">5</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="large_file_strong_warning_limit_row">
                    <property name="title" translatable="yes">Strong Warning From (MiB)</property>
                    <property name="subtitle" translatable="yes">Show the stronger editing warning for files at least this large</property>
                    <property name="editable">true</property>
                    <property name="numeric">true</property>
                    <property name="snap-to-ticks">true</property>
                    <property name="digits">0</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">3</property>
                        <property name="upper">500</property>
                        <property name="value">75</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">10</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="large_file_viewer_only_limit_row">
                    <property name="title" translatable="yes">Viewer Only Above (MiB)</property>
                    <property name="subtitle" translatable="yes">Files larger than this always open in the read-only viewer</property>
                    <property name="editable">true</property>
                    <property name="numeric">true</property>
                    <property name="snap-to-ticks">true</property>
                    <property name="digits">0</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">4</property>
                        <property name="upper">500</property>
                        <property name="value">500</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">25</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="large_file_always_edit_row">
                    <property name="title" translatable="yes">Always Allow Large File Editing</property>
                    <property name="subtitle" translatable="yes">Skip prompts below the measured hard editing limit</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="source_control_preferences_page">
        <property name="title" translatable="yes">Source Control</property>
        <property name="icon-name">io.github.cadric.Riteed-source-control-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Git Identity</property>
            <child>
              <object class="AdwEntryRow" id="git_name_row">
                <property name="title" translatable="yes">Name</property>
                <property name="show-apply-button">true</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="git_email_row">
                <property name="title" translatable="yes">Email</property>
                <property name="show-apply-button">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
