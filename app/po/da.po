msgid ""
"Autosave is available for already-saved writable files, while read-only and "
"externally changed files stay guarded by explicit user choices."
msgstr "Autogem er tilgængelig for allerede gemte skrivbare filer, mens skrivebeskyttede og eksternt ændrede filer fortsat beskyttes af eksplicitte brugervalg."

msgid ""
"Autosave paused because the document contains characters that cannot be "
"saved with the selected encoding."
msgstr "Autogem er sat på pause, fordi dokumentet indeholder tegn, der ikke kan gemmes med den valgte kodning."

msgid "Autosave paused because the document is too large to save safely."
msgstr "Autogem er sat på pause, fordi dokumentet er for stort til at blive gemt sikkert."

msgid "Autosave paused because the file changed on disk."
msgstr "Autogem er sat på pause, fordi filen blev ændret på disken."

msgid "Autosave paused because the file could not be written."
msgstr "Autogem er sat på pause, fordi filen ikke kunne skrives."

msgid "Binary files cannot be compared."
msgstr "Binære filer kan ikke sammenlignes."

